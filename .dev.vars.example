# Copy to .dev.vars to preview the Cloudflare Workers build locally with
# `npx wrangler dev` / `npx vite preview` — same keys as .env.example.
# https://developers.cloudflare.com/workers/configuration/environment-variables/#interact-with-environment-variables-locally

DATABASE_URL=postgres://user:password@host:5432/dbname
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
