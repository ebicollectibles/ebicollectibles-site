# Copy this file to .env for local development (never commit the real .env).
# In production (Cloudflare), set these as Worker secrets instead — see README-DEPLOY.md.

# Postgres connection string. Any standard Postgres works (self-hosted, Neon,
# Supabase, RDS, ...). Locally this points at a plain Postgres; in production
# on Cloudflare Workers we recommend proxying it through a Hyperdrive binding
# for connection pooling — see README-DEPLOY.md.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared password for the /admin panel (single operator, no user accounts).
ADMIN_PASSWORD=change-me

# Random string, 32+ characters, used to sign/encrypt the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# --- Square payments (server-side) ---
# Leave unset to run in test mode: orders are recorded but no card is charged.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# --- Square refund webhook ---
# Leave unset to skip refund tracking entirely (the rest of the site works
# fine without this). Requires subscribing to refund.created and
# refund.updated at https://developer.squareup.com/apps -> your app ->
# Webhooks, pointing at https://<your-domain>/api/webhooks/square — the
# signature key shown there goes here.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Square payments (client-side / Web Payments SDK) ---
# Vite exposes VITE_-prefixed vars to the browser bundle. LOCATION_ID and
# APPLICATION_ID are not secret (Square's own docs use them client-side).
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_ENVIRONMENT=sandbox

# --- Order confirmation email (Resend) ---
# Leave unset to skip sending confirmation emails entirely (checkout still
# works fine without this — it's best-effort and never blocks an order).
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend, e.g.:
# ORDER_FROM_EMAIL=EBI Collectibles <orders@ebicollectibles.com>
ORDER_FROM_EMAIL=

# --- Account emails: verification codes, password resets (Resend) ---
# Separate "from" address so these don't look like they came from the same
# mailbox as order receipts. Falls back to ORDER_FROM_EMAIL if left unset —
# no new domain verification needed, Resend verifies per-domain, so any
# address on the same already-verified domain works immediately.
# ACCOUNT_FROM_EMAIL=EBI Collectibles <accounts@ebicollectibles.com>
ACCOUNT_FROM_EMAIL=

# --- Customer accounts: Google sign-in ---
# Leave unset to hide "Continue with Google" — email/password signup still
# works fine without this. From a Google Cloud Console OAuth Client ID
# (type: Web application). GOOGLE_REDIRECT_URI must exactly match one of the
# Authorized redirect URIs on that client — register both this local one and
# your production URL (e.g. https://ebicollectibles.com/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
